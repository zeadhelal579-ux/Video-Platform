{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/upload", "destination": "/index.html" },
    { "source": "/watch/:id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/demo/v1/:file*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/demo/v1/:clip/:playlist.m3u8",
      "headers": [{ "key": "Content-Type", "value": "application/vnd.apple.mpegurl" }]
    },
    {
      "source": "/demo/v1/:clip/:segment.ts",
      "headers": [{ "key": "Content-Type", "value": "video/mp2t" }]
    }
  ]
}
