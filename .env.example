# Copy this file to .env.local ONLY if your Api is not at the development default.
#
# Development (npm run dev): when this variable is not set, the app calls
# http://localhost:5000 — where `dotnet run` puts VideoPlatform.Api
# (see back/src/VideoPlatform.Api/Properties/launchSettings.json).
#
# Production builds (npm run build, or the Docker image): when this variable is
# not set, the app calls the SAME origin ("/api/..."), which is what the nginx
# in the web container proxies to the Api. Set it only if the Api lives on a
# different address, e.g. https://api.example.com (then also list the app's
# address in the Api's Frontend__Origin setting for CORS).
VITE_API_BASE_URL=http://localhost:5000
