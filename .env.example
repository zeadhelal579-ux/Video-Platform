# File: .env.example
# Purpose: Every setting docker-compose.yml reads (BACKEND only — the frontend is
# configured on Vercel, see its own README). Copy to ".env" (never commit that
# file) and fill in the secrets. Docker Compose loads .env automatically.
# Tip: keep passwords to letters and digits — they are placed inside a
# PostgreSQL connection string, where ; = " and spaces have special meaning.
#   Generate one:  openssl rand -hex 24

# ---------------------------------------------------------------------------
# 1) Secrets — REQUIRED, change every one
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# Signs the login tokens. At least 32 characters:  openssl rand -hex 32
JWT_SIGNING_KEY=
# Storage credentials. With the bundled MinIO these become its root user/password
# (user: 3+ characters, password: 8+ characters).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# 2) The frontend (hosted on Vercel) and how its cookie works
#    Read DEPLOYMENT.md section 3 — pick ONE of the three setups.
# ---------------------------------------------------------------------------
# Exact origin(s) of the frontend, as the browser shows them: scheme + host, no path,
# no trailing slash needed. Several allowed, comma-separated. This is the CORS allow-list.
# Local development with `npm run dev` on the frontend:  http://localhost:5173
APP_URL=http://localhost:5173
# SameSite mode of the refresh-token cookie:
#   Strict  (default) — frontend and Api on the same site: Vercel "/api" rewrite (setup A)
#                       or sibling subdomains app.example.com + api.example.com (setup B)
#   None              — frontend and Api on different sites, e.g. myapp.vercel.app calling
#                       api.other.com directly (setup C). Needs HTTPS; Safari/iOS lose the
#                       session on reload, so prefer A or B.
AUTH_COOKIE_SAMESITE=Strict
# Login/register attempts allowed per minute per client IP. With the Vercel "/api"
# rewrite (setup A) every visitor reaches the Api from Vercel's servers, so raise this
# (for example 120); account lockout still protects each account.
AUTH_RATE_LIMIT_PER_MINUTE=20
# Host port (loopback only) the Api is published on, for a tunnel/proxy running on this machine.
API_PORT=8080

# ---------------------------------------------------------------------------
# 3) Storage — option A: bundled MinIO on this server (default; demo / single VM)
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=local-storage
S3_BUCKET=videoplatform
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Address the Api/Worker use INSIDE the Docker network:
S3_ENDPOINT_INTERNAL=http://minio:9000
# Address the BROWSER uses for uploads (must be reachable from users' machines AND
# be https:// when the frontend is on Vercel — see section 4):
S3_ENDPOINT_PUBLIC=http://localhost:9000
# Where the player loads video from (the public endpoint + "/" + bucket):
MEDIA_BASE_URL=http://localhost:9000/videoplatform

# ---------------------------------------------------------------------------
# 3) Storage — option B: AWS S3 (+ CDN). Replace the block above with this one.
#    Leave COMPOSE_PROFILES empty (or just "https") so MinIO is not started, and apply
#    deploy/s3-cors.json to the bucket with your frontend's origin.
# ---------------------------------------------------------------------------
# COMPOSE_PROFILES=https
# S3_BUCKET=my-video-bucket
# S3_REGION=eu-central-1
# S3_FORCE_PATH_STYLE=false
# S3_ENDPOINT_INTERNAL=
# S3_ENDPOINT_PUBLIC=
# MEDIA_BASE_URL=https://cdn.example.com

# Docker images for the bundled MinIO (optional). The defaults are used when unset.
# MINIO_IMAGE=minio/minio:latest
# MINIO_MC_IMAGE=minio/mc:latest

# ---------------------------------------------------------------------------
# 4) HTTPS with automatic certificates — REQUIRED when the frontend is on Vercel
#    A Vercel site is https://, and browsers refuse to call plain http:// addresses
#    from it (mixed content). Add "https" to COMPOSE_PROFILES, point the DNS names
#    below at this server (ports 80 and 443 open), and use the https names:
#      COMPOSE_PROFILES=local-storage,https
#      S3_ENDPOINT_PUBLIC=https://media.example.com
#      MEDIA_BASE_URL=https://media.example.com/videoplatform
# ---------------------------------------------------------------------------
# API_DOMAIN=api.example.com
# MEDIA_DOMAIN=media.example.com

# ---------------------------------------------------------------------------
# 5) Worker tuning (optional)
# ---------------------------------------------------------------------------
# Videos one Worker transcodes at once (FFmpeg already uses all CPU cores).
WORKER_MAX_CONCURRENT_JOBS=1
# Give up on one processing attempt after this many minutes.
WORKER_TIMEOUT_MINUTES=180
